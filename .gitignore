# Dependencies
/node_modules

# Temporary files (builds, cache, etc.)
# The tmp/ directory has its own .gitignore that excludes everything

# Logs
npm-debug.log*
*.log
yarn-debug.log*
yarn-error.log*

# Environment variables
# IMPORTANT: Only .example files should be committed
# Development and test .env files are safe to commit (no real secrets)
# Production .env files must NEVER be committed (contain real secrets)

# Root level (legacy, can be removed after migration)
.env
.env.local

# Backend (.env.development and .env.test are safe to commit)
app/api/.env
app/api/.env.production
app/api/.env.*.local

# Frontend (.env.development, .env.test, .env.production are safe to commit for Vite)
app/frontend/.env
app/frontend/.env.*.local

# IDE configuration
.idea/
.vscode/

# macOS
.DS_Store

docker/data
coverage/
playwright-report/
test-results/
app/api/dist/
app/frontend/dist/

# Local database binaries (MongoDB/PostgreSQL)
docker/dev/mongo/data/
docker/dev/postgres/data/
docker/test/mongo/data/
docker/test/postgres/data/
