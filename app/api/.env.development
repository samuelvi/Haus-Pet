# ===========================================
# HAUSPET API - DEVELOPMENT ENVIRONMENT
# ===========================================
# This file contains configuration for local development
# Safe to commit (no real secrets)

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/hauspet_db
DB_HOST=localhost
DB_USER=user
DB_PASSWORD=password
DB_NAME=hauspet_db
DB_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB Audit Database
AUDIT_DB_URI=mongodb://audit_user:audit_pass@localhost:27017/audit_log_db?authSource=admin

# Persistence Layer
PERSISTENCE_TYPE=postgres

# JWT Configuration (Development - NOT for production)
JWT_SECRET=dev-secret-key-change-in-production-12345678
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-key-change-in-production-12345678
JWT_REFRESH_EXPIRES_IN=7d

# MCP Server API Token (for Claude Desktop integration)
MCP_API_TOKEN=mcp-dev-token-admin-hauspet-2024

# Pagination Configuration
DEFAULT_PAGE_SIZE=5
ADMIN_PAGE_SIZE=4
MAX_PAGE_SIZE=20
