# ===========================================
# HAUSPET API - PRODUCTION ENVIRONMENT
# ===========================================
# IMPORTANT: This is a TEMPLATE file
# - Copy this file to .env.production on your production server
# - Replace ALL placeholder values with real production secrets
# - NEVER commit .env.production to git
# - Use strong, randomly generated secrets for production

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
# REQUIRED: Use a secure PostgreSQL connection string
# Example: postgresql://prod_user:STRONG_PASSWORD@db.example.com:5432/hauspet_prod_db?sslmode=require
DATABASE_URL=postgresql://CHANGEME_USER:CHANGEME_PASSWORD@CHANGEME_HOST:5432/CHANGEME_DB_NAME?sslmode=require
DB_HOST=CHANGEME_DB_HOST
DB_USER=CHANGEME_DB_USER
DB_PASSWORD=CHANGEME_DB_PASSWORD
DB_NAME=CHANGEME_DB_NAME
DB_PORT=5432

# Redis Configuration
# REQUIRED: Use a secure Redis connection
REDIS_HOST=CHANGEME_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD

# MongoDB Audit Database
# REQUIRED: Use a secure MongoDB connection string
# Example: mongodb://prod_user:STRONG_PASSWORD@mongo.example.com:27017/audit_prod_db?authSource=admin&ssl=true
AUDIT_DB_URI=mongodb://CHANGEME_USER:CHANGEME_PASSWORD@CHANGEME_HOST:27017/CHANGEME_AUDIT_DB?authSource=admin&ssl=true

# Persistence Layer
PERSISTENCE_TYPE=postgres

# JWT Configuration
# CRITICAL: Generate strong random secrets (min 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET=CHANGEME_GENERATE_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGEME_GENERATE_DIFFERENT_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# MCP Server API Token (Optional - only if using Claude Desktop integration)
MCP_API_TOKEN=CHANGEME_LONG_LIVED_API_TOKEN_IF_NEEDED

# Pagination Configuration
DEFAULT_PAGE_SIZE=10
ADMIN_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Optional: Monitoring & Logging
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# LOG_LEVEL=info
