# ===========================================
# HAUSPET API - TEST ENVIRONMENT
# ===========================================
# This file contains configuration for automated testing
# Safe to commit (no real secrets)

# Server Configuration
NODE_ENV=test
PORT=3000

# Database Configuration (Test database)
DATABASE_URL=postgresql://user:password@localhost:5432/hauspet_test_db
DB_HOST=localhost
DB_USER=user
DB_PASSWORD=password
DB_NAME=hauspet_test_db
DB_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB Audit Database (Test)
AUDIT_DB_URI=mongodb://audit_user:audit_pass@localhost:27017/audit_log_test_db?authSource=admin

# Persistence Layer
PERSISTENCE_TYPE=postgres

# JWT Configuration (Test - short expiration for faster tests)
JWT_SECRET=test-secret-key-for-automated-testing-only
JWT_EXPIRES_IN=5m
JWT_REFRESH_SECRET=test-refresh-secret-key-for-automated-testing-only
JWT_REFRESH_EXPIRES_IN=1d

# MCP Server API Token (Test)
MCP_API_TOKEN=mcp-test-token-12345

# Pagination Configuration (Test - smaller pages for faster tests)
DEFAULT_PAGE_SIZE=5
ADMIN_PAGE_SIZE=4
MAX_PAGE_SIZE=100
