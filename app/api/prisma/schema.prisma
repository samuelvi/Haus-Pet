// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "eventstore", "readmodels"]
}

model BreedType {
  id        String   @id // UUIDv7 generated in application code
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  breeds    Breed[]

  @@map("breed_types")
  @@schema("public")
}

model Breed {
  id          String    @id // UUIDv7 generated in application code
  name        String    @unique
  breedTypeId String    @map("breed_type_id")
  breedType   BreedType @relation(fields: [breedTypeId], references: [id])

  @@map("breed")
  @@schema("public")
}

model User {
  id           String        @id // UUIDv7 generated in application code
  email        String        @unique
  passwordHash String?       @map("password_hash") // Optional for sponsor users
  name         String
  role         Role          @default(USER)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sponsorships Sponsorship[] // Relation to sponsorships

  @@map("users")
  @@schema("public")
}

enum Role {
  ADMIN
  USER

  @@schema("public")
}

// Event Sourcing: Event Store table
// Isolated in 'eventstore' schema for future scalability
model Event {
  id            String   @id // UUIDv7 generated in application code
  aggregateId   String   @map("aggregate_id")
  aggregateType String   @map("aggregate_type") // "Animal" or "Sponsorship"
  eventType     String   @map("event_type") // "AnimalCreated", "SponsorshipMade", etc.
  eventData     Json     @map("event_data") // Event payload as JSON
  metadata      Json? // Additional metadata (userId, ip, etc.)
  version       Int // Optimistic locking
  timestamp     DateTime @default(now())

  @@index([aggregateId, version])
  @@index([aggregateType])
  @@index([eventType])
  @@map("events")
  @@schema("eventstore")
}

// Read Model: Pets (projected from events)
// Isolated in 'readmodels' schema for future scalability
model Pet {
  id             String        @id // UUIDv7 generated in application code
  name           String
  type           String
  breed          String
  photoUrl       String        @map("photo_url")
  totalSponsored Decimal       @default(0) @map("total_sponsored") @db.Decimal(10, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  sponsorships   Sponsorship[] // Relation to sponsorships

  @@map("pets")
  @@schema("readmodels")
}

// Read Model: Sponsorships (projected from events)
// Isolated in 'readmodels' schema for future scalability
model Sponsorship {
  id        String   @id // UUIDv7 generated in application code
  petId     String   @map("pet_id")
  userId    String   @map("user_id")
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([userId])
  @@map("sponsorships")
  @@schema("readmodels")
}
