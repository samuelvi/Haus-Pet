# ===========================================
# HAUSPET FRONTEND - DEVELOPMENT ENVIRONMENT
# ===========================================
# This file contains configuration for local development
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the browser

# API Base URL
VITE_API_URL=http://localhost:3000

# Client-side validation toggle (DEVELOPMENT/TESTING ONLY)
# WARNING: In production, this should ALWAYS be 'false'
# Purpose: Disable client validation to test server-side validation
# Security: Backend ALWAYS validates regardless of this setting
# Set to 'true' ONLY for testing server validation in development
VITE_DISABLE_CLIENT_VALIDATION=false

# Optional: Feature flags for development
# VITE_ENABLE_DEBUG_MODE=true
# VITE_ENABLE_DEV_TOOLS=true
