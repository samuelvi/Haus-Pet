# ===========================================
# HAUSPET FRONTEND - PRODUCTION ENVIRONMENT
# ===========================================
# This file contains configuration for production builds
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the browser
# WARNING: These values are embedded in the built JS files at build time

# API Base URL
# IMPORTANT: Change this to your production API domain
# This value is baked into the build and visible to users
VITE_API_URL=https://api.hauspet.com

# Client-side validation (MUST be false in production)
VITE_DISABLE_CLIENT_VALIDATION=false

# Optional: Production feature flags
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_ERROR_REPORTING=true
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
