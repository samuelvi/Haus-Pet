# ===========================================
# HAUSPET FRONTEND - TEST ENVIRONMENT
# ===========================================
# This file contains configuration for automated testing (Playwright, etc.)
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the browser

# API Base URL (pointing to test API)
VITE_API_URL=http://localhost:3000

# Client-side validation (enabled for most tests)
VITE_DISABLE_CLIENT_VALIDATION=false

# Optional: Test-specific settings
# VITE_ENABLE_DEBUG_MODE=false
# VITE_TEST_MODE=true
