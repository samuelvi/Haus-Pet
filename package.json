{
  "name": "hauspet-monorepo",
  "version": "1.0.0",
  "description": "HausPet monorepo - API and Frontend",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "dev:api": "cd app/api && npm run dev",
    "dev:worker": "cd app/api && npm run start:worker",
    "dev:frontend": "cd app/frontend && npm run dev",
    "build:api": "cd app/api && npm run build",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:unit:ui": "vitest --ui tests/unit",
    "test:unit:coverage": "vitest run tests/unit --coverage",
    "test:integration": "playwright test tests/integration",
    "test:functional": "playwright test tests/functional",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:functional",
    "test": "npm run test:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@playwright/test": "^1.44.1",
    "@types/node": "^24.10.1",
    "@vitest/ui": "^3.2.4",
    "husky": "^9.0.11",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
